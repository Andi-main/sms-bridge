@page "/"
@using SmsBridge.Desktop.Models
@using SmsBridge.Desktop.Services
@inject IMessageStore MessageStore
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>SMS Bridge</PageTitle>

<div class="sms-page">
    <header class="page-header">
        <div>
            <h1>SMS Bridge</h1>
            <p>Messages from your phone</p>
        </div>

        <div class="connection-status">
            <span class="status-dot"></span>
            Demo mode
        </div>
        
    </header>

    <main class="message-list">
        @foreach (SmsMessage message in MessageStore.GetMessages().OrderByDescending(message => message.ReceivedAt))
        {
            <article class="message-card">
                <div class="message-header">
                    <strong>@message.Sender</strong>
                    <time>@message.ReceivedAt.ToString("HH:mm")</time>
                </div>

                <p>@message.Body</p>
            </article>
        }
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        MessageStore.MessageReceived += HandleMessageReceived;
    }

    private void HandleMessageReceived(SmsMessage message)
    {
        _ = InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        MessageStore.MessageReceived -= HandleMessageReceived;
    }

}