<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmsBridge.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="SMS Bridge">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            VerticalOptions="Center">

            <Label
                Text="SMS Bridge"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                Text="Disconnected"
                HorizontalOptions="Center" />

            <Button
                x:Name="ConnectButton"
                Text="Connect"
                Clicked="OnConnectClicked" />

            <Button
                x:Name="EnableSmsButton"
                Text="Enable SMS forwarding"
                Clicked="OnEnableSmsClicked" />

            <Label
                x:Name="SmsPermissionLabel"
                Text="SMS access is not enabled"
                HorizontalOptions="Center" />

            <Entry
                x:Name="SenderEntry"
                Placeholder="Sender"
                Text="Android phone" />

            <Editor
                x:Name="MessageEditor"
                Placeholder="Message"
                AutoSize="TextChanges"
                MinimumHeightRequest="100" />

            <Button
                x:Name="SendButton"
                Text="Send test message"
                Clicked="OnSendClicked"
                IsEnabled="False" />

            <Label
                x:Name="ResultLabel"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>